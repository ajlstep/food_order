# nuts (NATS) — food-order. Copy to .env (./init-env.sh does it).
# These are passwords for development on your own computer. Before the server
# is used by anyone else, change every one and put the same value in the
# .env of the service that uses it (users: USERS_NATS_PASSWORD, ...).
NATS_PASSWORD_ADMIN=dev-admin-change-me
NATS_PASSWORD_GATEWAY=dev-gateway-change-me
NATS_PASSWORD_USERS=dev-users-change-me
NATS_PASSWORD_BOT=dev-bot-change-me
NATS_PASSWORD_LOGS=dev-logs-change-me
NATS_PASSWORD_CORE=dev-core-change-me
NATS_PASSWORD_CATALOG=dev-catalog-change-me
NATS_PASSWORD_PARSER=dev-parser-change-me
