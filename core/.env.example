# core — food-order. Copy to .env and change only what you need: every value
# below is the default. Real environment variables win over this file.
# .env is in .gitignore.

# HTTP API for the bot (X-User-ID on every /v1 call)
CORE_ADDR=:9081
# core's own SQLite file: orders, prefs, recommendations, menu requests. Back it up.
CORE_DB_PATH=data/core.db
# What "today", "tomorrow" and the hours below mean
CORE_TZ=Europe/Chisinau

CORE_CATALOG_URL=http://catalog:9082
CORE_HTTP_TIMEOUT=10s

# NATS JetStream. Empty CORE_NATS_URL = no broker: HTTP only, picks from the score.
CORE_NATS_URL=nats://nats:4222
# Either a token, or user + password
CORE_NATS_TOKEN=
CORE_NATS_USER=
CORE_NATS_PASSWORD=
# core creates this stream on food.> (the other services wait for it)
CORE_NATS_STREAM=FOOD
CORE_NATS_DURABLE=core
# how long the stream keeps messages
CORE_NATS_MAX_AGE=168h

# --- menu scheduler (one menu for everybody) ---
# from this hour on, ask once for the menu of the next serving day
CORE_MENU_REQUEST_TIME=15:00
# days the kitchen serves, ISO (1 = Monday): Friday asks for Monday
CORE_MENU_DAYS=1,2,3,4,5
# no_menu: ask again after this pause...
CORE_MENU_RETRY_INTERVAL=30m
# ...until this hour on the day before the menu day, then alert
CORE_MENU_DEADLINE=20:00
# no answer at all in this time = source_unavailable
CORE_MENU_TIMEOUT=10m
# source_unavailable: first pause, doubled each time, at most the max
CORE_MENU_BACKOFF=1m
CORE_MENU_BACKOFF_MAX=30m
# source_unavailable: alert after this many sends
CORE_MENU_MAX_ATTEMPTS=5

# --- rating question (food.rating.requested), the day after the meal ---
CORE_RATING_TIME=10:00
# ask only about meals of the last N days (after a long outage: no flood)
CORE_RATING_LOOKBACK_DAYS=3

# --- recommendation ---
# false = llm is not asked; picks come from the score, without a reason
CORE_LLM_ENABLED=true
# llm did not answer in this time: picks from the score
CORE_LLM_TIMEOUT=3m
# top N by score sent to llm
CORE_REC_CANDIDATES=8
# how many the user gets
CORE_REC_PICKS=5
# how far back the history goes for the score
CORE_REC_HISTORY_DAYS=90
# a new menu revision for a day = new recommendation for who has not chosen yet
CORE_REC_REGENERATE_ON_REVISION=false

# --- score (the same for everybody; the data is per user) ---
CORE_SCORE_WEIGHTS=rating=1,frequency=0.3,similarity=0.6,like=0.5,target=0.4,novelty=0.15,penalty=0.8,repeat=0.5
# prior strength of the Bayesian mean of ratings
CORE_SCORE_BAYES_C=2
# a dish chosen this many days ago or less is penalised
CORE_SCORE_REPEAT_DAYS=5
# calorie/macro target: compare the middle of the interval (mid) or the worse end (worst)
CORE_SCORE_TARGET_MODE=mid

# how often the scheduler looks around
CORE_TICK=30s
