# catalog — food-order. Copy to .env and change only what you need: every value
# below is the default. Real environment variables win over this file.
# .env is in .gitignore.

# HTTP API for core and bot (internal network only)
CATALOG_ADDR=:9082
# catalog's own SQLite file: dishes, menus, nutrition, allergens, embeddings. Back it up.
CATALOG_DB_PATH=data/catalog.db
# What "tomorrow" means for GET /v1/menu without a date
CATALOG_TZ=Europe/Chisinau

# NATS JetStream. Empty CATALOG_NATS_URL = no broker: HTTP only, llm is never asked.
CATALOG_NATS_URL=nats://nats:4222
# Either a token, or user + password
CATALOG_NATS_TOKEN=
CATALOG_NATS_USER=
CATALOG_NATS_PASSWORD=
# core creates this stream on food.>; catalog waits for it
CATALOG_NATS_STREAM=FOOD
CATALOG_NATS_DURABLE=catalog

# false = llm is never asked to analyse dishes (components, nutrition,
# allergens, portion, tags); the menu is ready with what the source gave
CATALOG_ANALYSIS_ENABLED=true
# false = no embeddings: POST /v1/similar answers with an empty list
CATALOG_EMBED_ENABLED=true
# llm did not answer about a dish in this time: food.alert, and the menu goes
# ready with what there is (nutrition_source = missing). A late answer is still saved.
CATALOG_ANALYSIS_TIMEOUT=30m

# POST /v1/import: load a menu by hand (the same body as food.menu.fetched).
# For debugging while the parser is not on NATS yet.
CATALOG_IMPORT_ENABLED=true

# how long the ids of processed events are kept (longer than the stream keeps messages)
CATALOG_PROCESSED_KEEP=720h
# how often catalog looks around: llm timeouts, publishes that failed
CATALOG_TICK=30s
