# catalog — food-order. Copy to .env and change only what you need: every value
# below is the default. Real environment variables win over this file.
# .env is in .gitignore.

# catalog's own SQLite file: dishes, menus, nutrition, allergens, embeddings. Back it up.
CATALOG_DB_PATH=data/catalog.db
# What "tomorrow" and the order limits of the partners mean
CATALOG_TZ=Europe/Chisinau
# The partners and their schedule, written by hand. Read at every start.
CATALOG_PARTNERS_FILE=partners.json

# NATS. The password is in nuts/.env (NATS_PASSWORD_CATALOG).
CATALOG_NATS_URL=nats://nats:4222
CATALOG_NATS_USER=catalog
CATALOG_NATS_PASSWORD=dev-catalog-change-me

# false = llm is never asked to analyse dishes (components, nutrition,
# allergens, portion, tags); the menu is ready with what the source gave.
# There is no llm service yet: with true, every menu would wait for it until
# CATALOG_ANALYSIS_TIMEOUT. Set true when it exists.
CATALOG_ANALYSIS_ENABLED=false
# false = no embeddings: similarity answers with an empty list
CATALOG_EMBED_ENABLED=false
# llm did not answer about a dish in this time: food.alert, and the menu goes
# ready with what there is (nutrition_source = missing). A late answer is still saved.
CATALOG_ANALYSIS_TIMEOUT=30m

# how long the ids of processed events are kept (longer than the stream keeps messages)
CATALOG_PROCESSED_KEEP=720h
# how often catalog looks around: llm timeouts, publishes that failed
CATALOG_TICK=30s

# Logs. Every log goes to NATS (logs.info, logs.warn, logs.error, logs.debug)
# and from there into the logs service (web UI on :9084); not to the console.
# true = also send the detailed logs: every request, every
# event in and out, every dish of an imported menu, every flush...
CATALOG_ADDITIONAL_LOGS=false
# true = also print every log to the console (docker logs). Without a broker
# or while a log cannot be sent, it goes to the console anyway.
CATALOG_LOG_CONSOLE=false
