# gateway — food-order. Copy to .env (./init-env.sh does it) and change only
# what you need: every value below is the default, except the key.
# Real environment variables win over this file. .env is in .gitignore.

# where the gateway listens (inside the container)
GATEWAY_HTTP_ADDR=:8080

# NATS. The user and password are in nuts/.env (NATS_PASSWORD_GATEWAY)
GATEWAY_NATS_URL=nats://nats:4222
GATEWAY_NATS_USER=gateway
GATEWAY_NATS_PASSWORD=dev-gateway-change-me

# The key the bot sends (Authorization: Bearer <key>). At least 32 characters.
# Whoever has it can speak for any Telegram user: change it, never commit it,
# and put the same value in the .env of the bot.
GATEWAY_BOT_KEY=dev-bot-key-change-me-0123456789abcdef

# how long the gateway waits for a service (no answer -> HTTP 504)
GATEWAY_RPC_TIMEOUT=5s

# Logs go to NATS (logs.info, ...) and show up in the logs service.
# true = also send the detailed logs (every request, how long it took)
GATEWAY_ADDITIONAL_LOGS=false
# true = also print every log to the console
GATEWAY_LOG_CONSOLE=false
