# users — food-order. Copy to .env (./init-env.sh does it) and change only what
# you need: every value below is the default, except the secret.
# Real environment variables win over this file. .env is in .gitignore.

# NATS. The user and password are in nuts/.env (NATS_PASSWORD_USERS)
USERS_NATS_URL=nats://nats:4222
USERS_NATS_USER=users
USERS_NATS_PASSWORD=dev-users-change-me

# SQLite file of the service: accounts, channels, codes. Back it up.
USERS_DB_PATH=data/users.db

# --- email confirmation ---
# Secret that signs the codes (at least 16 characters). Change it, and never commit it.
USERS_CODE_SECRET=dev-secret-change-me-please
# how long a code works
USERS_CODE_TTL=30m
# the pause before a new code can be asked
USERS_CODE_RESEND=30s
# wrong attempts before the code is cancelled
USERS_CODE_MAX_ATTEMPTS=5
# codes sent to one email address in an hour
USERS_CODES_PER_HOUR=5

# --- how letters leave ---
# console = the letter (with the code) is printed in `docker logs users`; nothing is sent. For development.
# smtp    = sent through the server below.
USERS_MAIL_DRIVER=console
USERS_MAIL_FROM=
USERS_SMTP_HOST=
USERS_SMTP_PORT=587
USERS_SMTP_USER=
USERS_SMTP_PASSWORD=

# Logs go to NATS (logs.info, ...) and show up in the logs service.
# true = also send the detailed logs (every request, how long it took)
USERS_ADDITIONAL_LOGS=false
# true = also print every log to the console
USERS_LOG_CONSOLE=false
