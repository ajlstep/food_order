# logs — food-order. Copy to .env and change only what you need: every value
# below is the default. Real environment variables win over this file.

# NATS JetStream (the same broker as the other services)
LOGS_NATS_URL=nats://nats:4222
# Either a token, or user + password
LOGS_NATS_TOKEN=
LOGS_NATS_USER=
LOGS_NATS_PASSWORD=
# logs creates this stream on LOGS_SUBJECT, so nothing is lost while the collector is down
LOGS_NATS_STREAM=LOGS
LOGS_NATS_SUBJECT=logs.>
LOGS_NATS_DURABLE=logs-collector
# how long NATS keeps a log in the stream (0 = forever)
LOGS_NATS_MAX_AGE=168h

# SQLite file shared by the collector (writes) and the web UI (reads)
LOGS_DB_PATH=data/logs.db
# rows older than this are deleted from the database (0 = keep forever)
LOGS_KEEP=720h

# web UI
LOGS_ADDR=:9084
