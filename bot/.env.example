# Copy to .env and fill in. .env is in .gitignore: never commit the token.

# From @BotFather
BOT_TELEGRAM_TOKEN=
# Your chat id (e.g. from @userinfobot): gets the alerts. Empty = only in the log.
BOT_ADMIN_CHAT_ID=
# Who may talk to the bot, comma separated. Empty = anybody who finds it.
BOT_ALLOWED_CHAT_IDS=

# Everything the bot asks goes through the gateway. The key is the same
# value as GATEWAY_BOT_KEY in gateway/.env: at least 32 characters.
BOT_GATEWAY_URL=http://gateway:8080
BOT_GATEWAY_KEY=dev-bot-key-change-me-0123456789abcdef

BOT_HTTP_TIMEOUT=10s

# NATS: only the queue of messages for people, and the logs. The password is
# in nuts/.env (NATS_PASSWORD_BOT). Empty URL = no notifications, only commands.
BOT_NATS_URL=nats://nats:4222
BOT_NATS_USER=bot
BOT_NATS_PASSWORD=dev-bot-change-me

BOT_ADDR=:8086

# webhook (on the server) | polling (local runs, no public address needed)
BOT_MODE=webhook
# Public https URL that Telegram calls; ports 443, 80, 88 or 8443 only.
# The reverse proxy (or ngrok) sends this path to bot:8086.
BOT_WEBHOOK_URL=https://ajl.duckdns.org/tg/webhook
# 16-256 chars of A-Z a-z 0-9 _ -   (openssl rand -hex 32)
BOT_WEBHOOK_SECRET=

# Logs go to NATS (logs.info, ...) and show up in the logs service, web UI on
# :9084; not to the console. No emails, codes, phones or names in them.
# true = also send the detailed logs (every call, every message, how long it took)
BOT_ADDITIONAL_LOGS=false
# true = also print every log to the console (docker logs)
BOT_LOG_CONSOLE=false
