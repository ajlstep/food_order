# Copy to .env and fill in. .env is in .gitignore: never commit the token.

# From @BotFather
BOT_TELEGRAM_TOKEN=
# Your chat id (e.g. from @userinfobot): gets the alerts (food.alert). Empty = only in the log.
BOT_ADMIN_CHAT_ID=
# Who may /start, comma separated. Empty = anybody who finds the bot.
BOT_ALLOWED_CHAT_IDS=

# Users and their settings (order time, order days, ...). Keep it out of Git and back it up.
BOT_DB_PATH=data/bot.db

BOT_CORE_URL=http://core:9081
BOT_CATALOG_URL=http://catalog:9082
BOT_HTTP_TIMEOUT=10s

# Empty = no events (only the commands work), handy while core is not ready.
BOT_NATS_URL=nats://nats:4222
# Either a token, or user + password
BOT_NATS_TOKEN=
BOT_NATS_USER=
BOT_NATS_PASSWORD=
BOT_NATS_STREAM=FOOD
BOT_NATS_DURABLE=bot

BOT_ADDR=:9001

# webhook (on the server) | polling (local runs, no public address needed)
BOT_MODE=webhook
# Public https URL that Telegram calls; ports 443, 80, 88 or 8443 only.
# The reverse proxy sends this path to bot:9001.
BOT_WEBHOOK_URL=https://ajl.duckdns.org/tg/webhook
# 16-256 chars of A-Z a-z 0-9 _ -   (openssl rand -hex 32)
BOT_WEBHOOK_SECRET=

# Logs. Every log goes to NATS (logs.info, logs.warn, logs.error, logs.debug)
# and from there into the logs service (web UI on :9084); not to the console.
# Always sent: every user action (command, button, text) with who did it,
# what the bot answered (refusals = warn), errors, the scheduler's requests.
# true = also send the detailed logs: every Telegram message sent with its
# text, every call to core/catalog with its body, every event, every tick...
BOT_ADDITIONAL_LOGS=false
# true = also print every log to the console (docker logs). Without a broker
# (BOT_NATS_URL empty) or while a log cannot be sent, it goes to the console anyway.
BOT_LOG_CONSOLE=false
