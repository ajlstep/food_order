# Copy to .env and change what you need. Every line is optional: the value
# shown is the default. Real environment variables win over this file.
# Loaded by internal/config; the file path can be changed with: parser -env path/to/file

# Which site module to use. Available: bistro
PARSER_SOURCE=bistro

# Page to download; {date} becomes YYYY-MM-DD.
# Empty = the default of the source (bistro: https://bistro.md/ro/catalog?date={date})
PARSER_SITE_URL=

# Second chance, asked only when the page above cannot be parsed or has no dishes;
# {week} becomes the ISO week of the date (2026-W44).
# Empty = the URL above with &week={week} added
# (bistro: https://bistro.md/ro/catalog?date={date}&week={week})
PARSER_SITE_URL_WEEK=

# Sent to the site with every request
PARSER_USER_AGENT=food-order-parser/1.0 (personal menu reader)

# Timeout of one request to the site (Go durations: 30s, 5m, 1h)
PARSER_HTTP_TIMEOUT=30s

# Where the HTTP API listens. In Docker keep it internal, do not publish the port.
PARSER_ADDR=:9083

# Time zone: decides what "tomorrow" is when /v1/fetch is called without a date
PARSER_TZ=Europe/Chisinau

# How long a menu that was found is kept before the site is asked again
PARSER_CACHE_TTL=3h

# Shortest pause between two requests to the site for the same day
# (also after an error or an empty menu)
PARSER_MIN_INTERVAL=10m

# Folder for the page of the last successful run (for debugging when the site changes)
PARSER_RAW_DIR=data/raw

# --- NATS (normal flow: core -> food.menu.requested -> parser) ---
# false = HTTP only (GET /v1/fetch, for debugging)
PARSER_NATS_ENABLED=true
PARSER_NATS_URL=nats://nats:4222
# Either a token, or user + password
PARSER_NATS_TOKEN=
PARSER_NATS_USER=
PARSER_NATS_PASSWORD=
# core creates this stream on food.>; the parser waits for it
PARSER_NATS_STREAM=FOOD
PARSER_NATS_DURABLE=parser
