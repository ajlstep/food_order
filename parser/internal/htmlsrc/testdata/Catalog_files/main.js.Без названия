// Scoped account CSRF for existing jQuery AJAX forms; never send to another origin.
jQuery.ajaxPrefilter(function(options) {
    var url = new URL(options.url, window.location.href);
    if (url.origin !== window.location.origin || !/^(POST|PUT|PATCH|DELETE)$/i.test(options.type || 'GET')) return;
    var token = document.querySelector('meta[name="account-csrf"]');
    if (!token) return;
    if (typeof options.data === 'string') options.data += '&account_csrf=' + encodeURIComponent(token.content);
    else if (options.data instanceof FormData) options.data.append('account_csrf', token.content);
    else options.data = Object.assign({}, options.data || {}, {account_csrf: token.content});
});
