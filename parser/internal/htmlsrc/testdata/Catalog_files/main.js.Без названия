function update_product_amount(current_element, productKey, value, update_input = false) {
    let totalElement = $('._total');
    let dishesElement = $('._dishes');
    let complexesElement = $('._complexes');
    let deliveryElement = $('._delivery');

    let url = '';
    if (getUrlParameter('date')) {
        url = '/update_product_amount?date=' + getUrlParameter('date');
    } else {
        url = '/update_product_amount';
    }

    $.ajax({
        type: 'POST',
        url: url,
        data: {
