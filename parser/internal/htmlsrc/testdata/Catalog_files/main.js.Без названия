            }

            if (response != '' && typeof JSON.parse(response).count_complexes !== 'undefined') {
                complexesElement.find('.list-sidebar-catalog__value').text(JSON.parse(response).count_complexes);
            }

            if (response != '' && typeof JSON.parse(response).final_total !== 'undefined') {
                totalElement.find('.list-sidebar-catalog__value').text(JSON.parse(response).final_total + ' mdl');
            }
            if (response != '' && typeof JSON.parse(response).delivery !== 'undefined') {
                deliveryElement.find('.list-sidebar-catalog__value').text(JSON.parse(response).delivery + ' mdl');
