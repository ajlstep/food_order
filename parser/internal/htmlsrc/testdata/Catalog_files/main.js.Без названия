            url: '/check_for_empty_cart',
            cache: false,
            success: function (response) {
                response = JSON.parse(response);

                if (response.empty == true) {
                    toastr.error(emptyBasket);
                    return false;
                }
            }
        });

        if (selectedTimeText == selectTimeLabel) {
            toastr.error(selectTimeLabel);
            return false;
        }

        let date = '';

        if (typeof getUrlParameter('date') !== 'undefined') {
            date = '&date=' + getUrlParameter('date');
        } else {
            date = '';
        }

        var lang = document.documentElement.lang;

        grecaptcha.ready(() => {
            grecaptcha.execute('6LfPmtYiAAAAACJofbUnJQGP7YnVi5Cc1JWIaAgB', {
                action: 'contact'
            }).then(token => {

                $.ajax({
                    type: 'POST',
                    url: '/accept_order?token=' + token + date,
                    data: {
                        lang: lang,
                        personal_data_consent: consent.checked ? '1' : '0',
                        delivery_time: selectedTimeText,
                        order_comment: $('#order_comment').val()
                    },
