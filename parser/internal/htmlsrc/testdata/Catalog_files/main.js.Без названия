        var $btn = $(this);
        $btn.prop('disabled', true);

        var $address = $('body .cart_block .cart_select_address').val();
        if (!$address) {
            $address = $('body .cart_block .cart_select_check_address').val();
        }
        if (!$address) {
            toastr.error(addressOrderUsedSend);
            $btn.prop('disabled', false);
            return false;
        }

        $.ajax({
