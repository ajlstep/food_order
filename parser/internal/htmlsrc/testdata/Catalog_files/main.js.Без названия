function update_cart() {
    let loader = $('.loader');
    let selectedLanguage = '';

    $('.language-header__item').each(function () {
        let currentLanguage = $(this);

        if (currentLanguage.hasClass('_active')) {
            selectedLanguage = currentLanguage.attr('data-lang');
        }
    });

    $.ajax({
        type: 'GET',
        url: getUrlParameter('date') ? '/' + selectedLanguage + '/update_cart?date=' + getUrlParameter('date') : '/' + selectedLanguage + '/update_cart',
        cache: false,
        data: {
            lang: $('.language-main-header__item._active').attr('data-lang')
        },
        success: function (response) {
            loader.removeAttr('style');
            loader.fadeOut('slow');

            let sideCart = JSON.parse(response).side_cart;

            $('.cart_block').remove();
            $('.main-catalog').after(sideCart);
            $('.mobile-cart-sticky__count').text(JSON.parse(response).count_dishes + JSON.parse(response).count_complexes);
            $('.mobile-cart-sticky').show();

            if (typeof localStorage.getItem('time_option') !== 'undefined') {
                $('select[name="time"]').find('option').each(function () {
                    if ($(this).val() == localStorage.getItem('time_option')) {
                        $(this).prop('selected', true);
                    }
                });
            }

            selects_init();

            setTimeout(function () {
                $('.wrapper').removeClass('hide-wrapper');
            }, 0);

            daySelectedDishes();
            show_empty_cart();
            $('.select_null').find('.select_null').remove();
        }
    });

    $('.quantity__input').each(function () {
        $(this).find('input').attr("value", 0);
    });
}

