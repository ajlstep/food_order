function bistroCurrentDeliveryAddress() {
    var options = $('.cart_select_address option.address_option').filter(function () { return !this.disabled && /^[1-9][0-9]*$/.test(this.value); });
    var stored = null;
    try { stored = localStorage.getItem('delivery_address'); } catch (error) {}
    var match = options.filter(function () { return this.value === stored; });
    if (match.length) return stored;
    try { localStorage.removeItem('delivery_address'); } catch (error) {}
    var selected = options.filter(':selected').first();
    return selected.length ? selected.val() : '';
}

// Cart validation is returned as JSON so the customer sees a message, including HTTP errors.
$(document).ajaxError(function (event, xhr, settings) {
    if (!/\/(?:add_to_cart|change_products_address|accept_order)(?:\?|$)/.test(settings.url || '')) return;
    var result = xhr.responseJSON;
    if (!result) { try { result = JSON.parse(xhr.responseText); } catch (error) {} }
    if (result && result.error) {
        if (result.code === 'delivery_address_unavailable') { try { localStorage.removeItem('delivery_address'); } catch (error) {} }
        toastr.error(result.error);
    }
});
