function dragFilters() {
    const scrollContainer = document.querySelector('.filter-catalog__list');

    if ($('.filter-catalog__list').length > 0) {
        let isDown = false;
        let startX;
        let scrollLeft;

        scrollContainer.addEventListener('mousedown', (e) => {
            isDown = true;
            scrollContainer.classList.add('active');
            startX = e.pageX - scrollContainer.offsetLeft;
            scrollLeft = scrollContainer.scrollLeft;
        });

        scrollContainer.addEventListener('mouseleave', () => {
            isDown = false;
            scrollContainer.classList.remove('active');
        });

        scrollContainer.addEventListener('mouseup', () => {
            isDown = false;
            scrollContainer.classList.remove('active');
        });

        scrollContainer.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - scrollContainer.offsetLeft;
            const walk = (x - startX) * 2; // Adjust scroll speed by changing the multiplier
            scrollContainer.scrollLeft = scrollLeft - walk;
        });
    }
}

function detectBrowser() {
    const userAgent = navigator.userAgent;

    if (userAgent.includes('Safari') && !userAgent.includes('Chrome')) {
        $('.week_select').css('display', 'none');
        $('#week').parent().removeAttr('style');
        return false;
    } else if (userAgent.includes('Firefox')) {
        $('.week_select').css('display', 'none');
        $('#week').parent().removeAttr('style');
        return false;
    } else {
        $('.week_select').removeAttr('style');
        $('#week').parent().css('display', 'none');
        return false;
    }
}

function edit_order(product, language) {
    $('.loader').removeAttr('style');

    var amount = parseInt(product.val(), 10);
    if (isNaN(amount) || amount <= 0) {
        amount = 1;
    }
    product.val(amount);

    $.ajax({
        type: 'POST',
        url: '/edit_order',
        data: {
            order_id: product.attr('data-order'),
            product_id: product.attr('data-id'),
            lang: language,
            amount: amount
        },
        success: function (response) {
            if (typeof JSON.parse(response).success !== 'undefined') {
                toastr.success(JSON.parse(response).success);
            } else {
                toastr.error(JSON.parse(response).error);
            }

            let price = product.parent().prev().find('span').text().replace(' mdl', '');
            product.parent().next().find('span').eq(0).text(product.val() * price + ' mdl');

            if (typeof JSON.parse(response).total !== 'undefined') {
                product.parent().parent().parent().parent().find('.content-item-order__footer').find('.content-item-order__total').find('span').eq(1).text(JSON.parse(response).total.toLocaleString(undefined, {
                    minimumFractionDigits: 2
                }) + ' mdl');
                product.parent().find('.amount_input').val(JSON.parse(response).amount);
            }
        },
        complete: function () {
            $('.loader').fadeOut('slow');
        }
    });
}

