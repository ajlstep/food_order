    $(document).on('click', '.open_popup', function () {
        let currentElement = $(this);
        let dishInfo = $('.dish_info');
        $('body').addClass('_noScroll');
        // let itemId = currentElement.parent().find('.buy-product__item').attr('data-id');
        let itemId = currentElement.attr('data-id');
        let itemPrice = currentElement.parent().find('.buy-product__item').attr('data-price');
        let currentLanguage = '';
        let hasAttr = typeof currentElement.attr('data-complex') !== 'undefined';

        if (currentElement.hasClass('open_popup_view')) {
            let clonedBuy = currentElement.parent().find('.buy-product').clone();

            $('.dish_info').find('.buy-product_special').html(clonedBuy.html());
        } else {
            let clonedBuy = currentElement.parent().find('.buy-product_special').clone();

            $('.dish_info').find('.buy-product_special').html(clonedBuy.html());
        }

        $('.language-header__item').each(function () {
            if ($(this).hasClass('_active')) {
                currentLanguage = $(this).attr('data-lang');
            }
        });

        let currentDate = '';

        if (getUrlParameter('date')) {
            currentDate = getUrlParameter('date');
        } else {
            currentDate = new Date();
            let dd = String(currentDate.getDate()).padStart(2, '0');
            let mm = String(currentDate.getMonth() + 1).padStart(2, '0');
            let yyyy = currentDate.getFullYear();
            currentDate = yyyy + '-' + mm + '-' + dd;
        }

        dishInfo.find('.popup__body').removeClass('block_add')

        $.ajax({
            type: 'GET',
            url: '/get_dish_info',
            data: {
                id: itemId,
                lang: currentLanguage,
                complex: hasAttr,
                date: currentDate
            },
            success: function (response) {
                response = JSON.parse(response);

                dishInfo.find('.popup__body').find('#name').text(response.dish.Name);


                let itemDishes = response.dish.items;

                dishInfo.find('.popup__body').find('#description').html('');

                if (typeof response.dish.items !== 'undefined') {
                    let descriptionString = '';

                    if (itemDishes[0]){
                        dishInfo.find('.popup__body').addClass(itemDishes[0].block)
                    }

                    // for (let i = 0; i < itemDishes.length; i = i + 1) {
                    if ((0 + 1) == itemDishes.length) {
                        for (let j = 0; j < itemDishes[0].Dishes.length; j = j + 1) {
                            if (itemDishes[0].Dishes[j]['Name' + currentLanguage.toUpperCase()] != '') {
                                descriptionString += itemDishes[0].Dishes[j]['Name' + currentLanguage.toUpperCase()] + ', ';
                            } else {
                                descriptionString += itemDishes[0].Dishes[j]['NameRO'] + ', ';
                            }
                        }
                    } else {
                        for (let j = 0; j < itemDishes[0].Dishes.length; j = j + 1) {
                            if (itemDishes[0].Dishes[j]['Name' + currentLanguage.toUpperCase()] != '') {
                                descriptionString += itemDishes[0].Dishes[j]['Name' + currentLanguage.toUpperCase()] + ', ';
                            } else {
                                descriptionString += itemDishes[0].Dishes[j]['NameRO'] + ', ';
                            }
                        }
                    }
                    // }

                    if (response.dish.items[0].composition) {
                        descriptionString = response.dish.items[0].composition.replace(/,\s*$/, "");
                    } else {
                        descriptionString = descriptionString.replace(/,\s*$/, "");
                    }


                    dishInfo.find('.popup__body').find('#description').html(descriptionString);
                } else if (hasAttr == false) {
                    let descriptionString = response.dish.Description;

                    dishInfo.find('.popup__body').find('#description').html(descriptionString);
                }

                if (response.dish.Image != '') {
                    $.ajax({
                        url: 'https://bistro.md/public/dishes/' + response.dish.Image,
                        type: 'HEAD',
                        error: function () {
                            dishInfo.find('.popup__body').find('img').attr('src', "/dist/img/logo.svg");
                        },
                        success: function () {
                            dishInfo.find('.popup__body').find('img').attr('src', "../public/dishes/" + response.dish.Image);
                            dishInfo.find('.popup__body').find('img').removeAttr('style');
                        }
                    });
                } else {
                    dishInfo.find('.popup__body').find('img').attr('src', "/dist/img/logo.svg");
                    dishInfo.find('.popup__body').find('img').css('margin-top', '35%');
                }
                dishInfo.addClass('_active');
            }
        });

        return false;
    });

