function enable_plus_minus() {
    if (typeof quantityButtons == 'undefined') {
        let quantityButtons = document.querySelectorAll('.quantity__button');
    }

    if (quantityButtons.length > 0) {
        for (let index = 0; index < quantityButtons.length; index++) {
            const quantityButton = quantityButtons[index];
            if (quantityButton.closest('.quantity').querySelector('input').value == 1) {
                quantityButton.closest('.quantity').querySelector('.quantity__button_minus').classList.add('_disabled')
            } else {
                quantityButton.closest('.quantity').querySelector('.quantity__button_minus').classList.remove('_disabled')
            }
            quantityButton.addEventListener("click", function (e) {
                let value = parseInt(quantityButton.closest('.quantity').querySelector('input').value);
                if (quantityButton.classList.contains('quantity__button_plus')) {
                    value++;
                } else {
                    value = value - 1;
                    if (value < 1) {
                        value = 1
                    }
                }

                if (value == 1) {
                    quantityButton.closest('.quantity').querySelector('.quantity__button_minus').classList.add('_disabled')
                } else {
                    quantityButton.closest('.quantity').querySelector('.quantity__button_minus').classList.remove('_disabled')
                }
                quantityButton.closest('.quantity').querySelector('input').value = value;
            });
        }
    }
}

function remove_lunch_order() {
    let currentDate = new Date();
    let dd = String(currentDate.getDate()).padStart(2, '0');
    let mm = String(currentDate.getMonth() + 1).padStart(2, '0');
    let yyyy = currentDate.getFullYear();

    $('.buy-product__item').each(function () {
        let breakfast = ['Завтрак', 'завтрак'];
        let lunch = ['Обед', 'обед'];
        let dinner = ['Ужин', 'ужин'];

        if (getUrlParameter('date') && getUrlParameter('date') == yyyy + '-' + mm + '-' + dd || !getUrlParameter('date')) {
            if (currentDate.getHours() >= 12 && lunch.includes($(this).attr('data-type'))) {
                $(this).prev().remove();
                $(this).remove();
            }

            if (currentDate.getHours() > 9 && breakfast.includes($(this).attr('data-type')) ||
                currentDate.getHours() < 7 && breakfast.includes($(this).attr('data-type')) ||
                currentDate.getHours() == 9 && currentDate.getMinutes() > 0 && breakfast.includes($(this).attr('data-type'))) {
                $(this).prev().remove();
                $(this).remove();
            }

            if (currentDate.getHours() > 18 && dinner.includes($(this).attr('data-type')) ||
                currentDate.getHours() == 18 && currentDate.getMinutes() > 0 && dinner.includes($(this).attr('data-type')) ||
                currentDate.getHours() < 11 && dinner.includes($(this).attr('data-type'))) {
                $(this).prev().remove();
                $(this).remove();
            }
        }
    });
}

function dateToISOWeek(dateString) {
    const date = new Date(dateString);

    // ISO: понедельник = 1, воскресенье = 7
    const day = (date.getDay() + 6) % 7;

    // Переносим дату на четверг текущей недели
    date.setDate(date.getDate() - day + 3);

    const isoYear = date.getFullYear();

    // Первый четверг года
    const firstThursday = new Date(isoYear, 0, 4);
    const firstDay = (firstThursday.getDay() + 6) % 7;
    firstThursday.setDate(firstThursday.getDate() - firstDay + 3);

    const week = 1 + Math.round((date - firstThursday) / 604800000);

    return `${isoYear}-W${String(week).padStart(2, '0')}`;
}


