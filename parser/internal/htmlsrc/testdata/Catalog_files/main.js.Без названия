        success: function (response) {
            if (update_input && response != '') {
                current_element.parent().parent().parent().parent().next().find('.list-product-sidebar__value').text(JSON.parse(response).price + ' mdl');
                current_element.parent().parent().parent().next().find('.list-product-sidebar__value').text(JSON.parse(response).price + ' mdl');
